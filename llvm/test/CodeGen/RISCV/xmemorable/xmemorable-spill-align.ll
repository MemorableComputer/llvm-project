define void @spill_m8(ptr %p) nounwind vscale_range(8,8) {
  %v = load volatile <vscale x 16 x i32>, ptr %p
  call void @sink()
  call void asm sideeffect "", "~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v8},~{v9},~{v10},~{v11},~{v12},~{v13},~{v14},~{v15},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31}"()
  store volatile <vscale x 16 x i32> %v, ptr %p
  ret void
}

; A scalable-vector LOCAL, not a spill: the same section, so the same
; guarantee has to hold for it.  The 40-byte scalar local is deliberately not
; a multiple of 64, so the RVV section base is only correct if the frame pads
; up to the bank word.  Before the fix this landed on `sp + 48` of a 320-byte
; frame -- 16 bytes into a bank word.
; CHECK-LABEL: rvv_local_after_scalar:
; CHECK:       addi sp, sp, -{{(64|128|192|256|320|384|448|512|576|640|704|768|832|896|960|1024)}}
; CHECK:       addi sp, sp, -{{(64|128|192|256|320|384|448|512|576|640|704|768|832|896|960|1024)}}
; CHECK:       addi [[SLOT:a[0-9]+]], sp, {{(0|64|128|192|256|320|384|448|512|576|640|704|768|832|896|960|1024)}}
; CHECK:       vs4r.v {{v[0-9]+}}, ([[SLOT]])
; MIR-LABEL: name:            rvv_local_after_scalar
; MIR:       maxAlignment:    64
define void @rvv_local_after_scalar(ptr %p) nounwind vscale_range(8,8) {
  %s = alloca [40 x i8], align 8
  %v = alloca <vscale x 8 x i32>, align 8
  call void @sink()
  %l = load volatile <vscale x 8 x i32>, ptr %p
  store volatile <vscale x 8 x i32> %l, ptr %v
  %r = load volatile <vscale x 8 x i32>, ptr %v
  store volatile <vscale x 8 x i32> %r, ptr %p
  store volatile i8 1, ptr %s
  ret void
}
