//
// Scheduling info for the XMemorable custom ops. GENERATED by
// isa/generate_isa.py --sched-td from isa/*.yaml (sched-model task 4;
// replaces the task-3 hand-written baseline) -- do not edit by hand. The
// yaml records carry the timing (sched_latency / sched_beats / sched_fu);
// lane and FU assignment derive from each record's source grouping and
// shape. Included from RISCVSchedXMemorable.td INSIDE
// `let SchedModel = XMemorableModel`.
//
// Annotations target the per-LMUL PSEUDOS (PseudoXMV_<OP>_M<X>) for every
// pseudo-backed op -- their real MC defs never reach the scheduler
// (hasNoSchedulingInfo) -- and the real defs only for the ops with no
// pseudo (tile.load/tile.store are m4-only with vl architecturally
// ignored; vappend/store.transposed/cmul/matrix.multiply_drain have no
// vector-register LMUL dimension).
//
// Dispatch lane occupancy is exactly 1 cycle (dense vector dispatch is how
// the hand .S kernels bank queue surplus); FU occupancy = beat count (LMUL
// beats for the per-LMUL pseudos, the record's sched_beats otherwise).
// Producer latencies coarse and round per the design (m4 producers ~8,
// drain ~20); tune only if the btb measurement demands it.
//
//===----------------------------------------------------------------------===//

foreach mx = ["M1", "M2", "M4", "M8"] in {
  defvar beats = !cond(!eq(mx, "M1") : 1,
                       !eq(mx, "M2") : 2,
                       !eq(mx, "M4") : 4,
                       !eq(mx, "M8") : 8);

  let Latency = 4, ReleaseAtCycles = [1, beats] in
  def XMWriteStoreFp4E8m0_ # mx : SchedWriteRes<[XMDispV, XMFuStore]>;
  def : InstRW<[!cast<SchedWriteRes>("XMWriteStoreFp4E8m0_" # mx)],
               (instrs !cast<Instruction>("PseudoXMV_STORE_FP4_E8M0_" # mx))>;

  let Latency = 4, ReleaseAtCycles = [1, beats] in
  def XMWriteStoreFp4E4m3_ # mx : SchedWriteRes<[XMDispV, XMFuStore]>;
  def : InstRW<[!cast<SchedWriteRes>("XMWriteStoreFp4E4m3_" # mx)],
               (instrs !cast<Instruction>("PseudoXMV_STORE_FP4_E4M3_" # mx))>;

  let Latency = 4, ReleaseAtCycles = [1, beats] in
  def XMWriteStoreFp4E8m3_ # mx : SchedWriteRes<[XMDispV, XMFuStore]>;
  def : InstRW<[!cast<SchedWriteRes>("XMWriteStoreFp4E8m3_" # mx)],
               (instrs !cast<Instruction>("PseudoXMV_STORE_FP4_E8M3_" # mx))>;

  let Latency = 8, ReleaseAtCycles = [1, beats] in
  def XMWriteVexp2diffVv_ # mx : SchedWriteRes<[XMDispV, XMFuSfu]>;
  def : InstRW<[!cast<SchedWriteRes>("XMWriteVexp2diffVv_" # mx)],
               (instrs !cast<Instruction>("PseudoXMV_VEXP2DIFF_VV_" # mx))>;

  let Latency = 8, ReleaseAtCycles = [1, beats] in
  def XMWriteVexp2diffFx_ # mx : SchedWriteRes<[XMDispV, XMFuSfu]>;
  def : InstRW<[!cast<SchedWriteRes>("XMWriteVexp2diffFx_" # mx)],
               (instrs !cast<Instruction>("PseudoXMV_VEXP2DIFF_FX_" # mx))>;
}

// cmul: scalar-lane GPR-to-GPR op (no FU issue queue behind the lane).
let Latency = 2 in
def XMWriteCmul : SchedWriteRes<[XMDispS]>;
def : InstRW<[XMWriteCmul], (instrs XMV_CMUL)>;

// vappend appends one row via the load FU's spine (sched_fu: load;
// yaml: "rides the memory FU load path").
let Latency = 2, ReleaseAtCycles = [1, 1] in
def XMWriteVappend : SchedWriteRes<[XMDispV, XMFuLoad]>;
def : InstRW<[XMWriteVappend], (instrs XMV_VAPPEND)>;

// store.transposed writes one bank row via the store FU (sched_fu: store).
let Latency = 4, ReleaseAtCycles = [1, 1] in
def XMWriteStoreTransposed : SchedWriteRes<[XMDispV, XMFuStore]>;
def : InstRW<[XMWriteStoreTransposed], (instrs XMV_STORE_TRANSPOSED)>;

// tile.load / tile.store: real m4-only defs (no pseudo; vl architecturally
// ignored), 4 beats each -- one row per beat across the m4 group.
let Latency = 8, ReleaseAtCycles = [1, 4] in
def XMWriteTileLoad : SchedWriteRes<[XMDispV, XMFuLoad]>;
def : InstRW<[XMWriteTileLoad], (instrs XMV_TILE_LOAD)>;

let Latency = 4, ReleaseAtCycles = [1, 4] in
def XMWriteTileStore : SchedWriteRes<[XMDispV, XMFuStore]>;
def : InstRW<[XMWriteTileStore], (instrs XMV_TILE_STORE)>;

// matrix.multiply_drain: matrix lane, 16 beats (accumulator depth) through
// the matrix FU, drain results land ~20 cycles out.
let Latency = 20, ReleaseAtCycles = [1, 16] in
def XMWriteMatrixMultiplyDrain : SchedWriteRes<[XMDispM, XMFuMatrix]>;
def : InstRW<[XMWriteMatrixMultiplyDrain], (instrs XMV_MATRIX_MULTIPLY_DRAIN)>;
